# ---------------------------------------------------------------------------
# Apenas NOMES de variáveis e valores ilustrativos. Os valores reais ficam SOMENTE
# em Netlify > Site configuration > Environment variables (nunca no repositório).
# ---------------------------------------------------------------------------

# Banco (Supabase Postgres) — já existente no projeto
SUPABASE_DB_POOLER_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres

# Mercado Pago (PIX) — https://www.mercadopago.com.br/developers
# Access Token de PRODUÇÃO (Suas integrações > Credenciais de produção). Formato APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=APP_USR-exemplo-nao-e-um-segredo-real
# Public Key (Credenciais de produção, formato APP_USR-...). OBRIGATÓRIA para liberar o pagamento com cartão no checkout.
# É feita para ficar no navegador (diferente do Access Token, que é secreto).
MERCADOPAGO_PUBLIC_KEY=APP_USR-exemplo-public-key
# Opcional: 'optional' (padrão) deixa o banco pedir confirmação 3DS quando necessário; 'not_supported' desliga o 3DS.
MERCADOPAGO_3DS_MODE=optional
# Opcional: texto que aparece na fatura do cartão (até 22 caracteres).
MERCADOPAGO_STATEMENT_DESCRIPTOR=TENISHEAD
# Chave secreta do webhook (Suas integrações > Webhooks > Configurar notificações). Valida o x-signature.
MERCADOPAGO_WEBHOOK_SECRET=exemplo_nao_e_um_segredo_real
# URL que o Mercado Pago chama quando o pagamento muda de status (opcional se já cadastrou no painel).
MERCADOPAGO_NOTIFICATION_URL=https://SEU-SITE.netlify.app/.netlify/functions/mercadopago-webhook
# Opcional: validade do PIX em minutos (padrão 30).
MERCADOPAGO_PIX_EXPIRATION_MINUTES=30
# Opcional (padrão: https://api.mercadopago.com). Precisa ser HTTPS.
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Opcional: timeout das chamadas à API em ms (padrão 8000).
MERCADOPAGO_TIMEOUT_MS=8000

# Pontuação
POINTS_PER_REAL=1

# WhatsApp API / Meta Cloud API-compatible endpoint
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_OWNER_PHONE=
# Alternativa GRATUITA (CallMeBot): se definida, é usada no lugar da API da Meta.
CALLMEBOT_API_KEY=

# Optional timezone used in WhatsApp notification
TZ=America/Fortaleza
